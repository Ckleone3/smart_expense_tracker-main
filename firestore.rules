rules_version = '2';

// Smart Expense Tracker — Firestore security rules.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console → Firestore Database → Rules)
//
// Key guarantees:
//  • A user can only read/write their OWN data.
//  • Nobody can make themselves Premium from the app — the subscription
//    status is read-only to clients and may only be written by the backend
//    (a Cloud Function / Admin SDK, which bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Developer/owner accounts — keep in sync with kAdminEmails in the app.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['lckipling@gmail.com', 'cheruiyotleonard3@gmail.com'];
    }

    match /users/{userId} {
      // The user document itself.
      allow read, write: if isOwner(userId);

      // Subscription status — clients may READ but never WRITE.
      // Premium is granted only by the payment backend (Admin SDK bypasses rules).
      match /subscription/{doc} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // All other per-user collections: owner only.
      match /categories/{doc}   { allow read, write: if isOwner(userId); }
      match /allocations/{doc}  { allow read, write: if isOwner(userId); }
      match /settings/{doc}     { allow read, write: if isOwner(userId); }
      match /summary/{doc}      { allow read, write: if isOwner(userId); }
      match /transactions/{doc} { allow read, write: if isOwner(userId); }
      match /sms_keywords/{doc} { allow read, write: if isOwner(userId); }
    }

    // Activation keys (device-locked licensing). You create the key docs in the
    // Firebase console as: licenses/<KEY> { active: true, deviceId: "" }.
    // A signed-in app may read a key and bind it to one device exactly once;
    // it can never create, delete, disable, or re-point a key to a new device.
    match /licenses/{key} {
      allow read: if request.auth != null;

      // Admin (developer) has full control to generate/manage keys.
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // A normal signed-in user may bind an UNUSED key to one device only.
        || (request.auth != null
            && (!('deviceId' in resource.data) || resource.data.deviceId == ''
                || resource.data.deviceId == null)
            && request.resource.data.deviceId is string
            && request.resource.data.deviceId.size() > 0
            && request.resource.data.active == resource.data.active);
    }

    // NOTE: review the top-level 'expenses' collection used by
    // expense_list_screen.dart — it is not scoped per-user. Consider moving it
    // under /users/{uid}/expenses. Until then it is denied by default (no rule).
  }
}
